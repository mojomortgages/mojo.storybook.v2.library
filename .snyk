# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.1
# ignores vulnerabilities until expiry date; change duration by modifying expiry date
ignore:
  6e3438c0-b45b-402e-9dae-854561dc9c14:
    - src/FormatInput.js:
        reason: >-
          Public prop-types library sentinel constant
          SECRET_DO_NOT_PASS_THIS_OR_YOU_WILL_BE_FIRED, unchanged since 2013 in
          the open-source prop-types package, vendored into bundled build output
          via react-number-format -> prop-types. Not a credential, not
          exploitable. Approved by Callum Evans (Linear ticket AIA-6755).
          Re-adjudicated under AIA-15845 (2026-10-06): confirmed via npm pack
          of prop-types@15.8.1 that the string is present verbatim in the
          genuine upstream package, and a repo-wide sweep found no other
          hardcoded credentials. False positive stands; ignore retained as-is.
        expires: 2027-07-28T00:00:00.000Z
        created: 2026-07-28T16:17:57.281Z
